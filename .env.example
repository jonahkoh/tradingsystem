# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Generate Binance Testnet keys at:
#   https://testnet.binance.vision/
# ──────────────────────────────────────────────
# Roostoo API credentials (generate from your Roostoo account dashboard)
API_KEY=your_roostoo_api_key_here
SECRET_KEY=your_roostoo_secret_key_here

# Roostoo base URL (mock exchange endpoint)
ROOSTOO_BASE_URL=https://mock-api.roostoo.com

# Redis connection (matches docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6379

# Trading parameters
TRADE_SYMBOL=BTCUSDT
TRADE_QUANTITY=0.001

# Data feed: false = real Binance production WebSocket (live prices, no auth needed)
#            true  = Binance testnet stream (simulated prices)
# Execution Manager always targets Binance Testnet REST regardless of this flag.
FEED_TESTNET=false

# ── BTC/ETH Mean Reversion Strategy ───────────────────────────────────────────
# Bollinger Band window (120 × 5s ≈ 10 min; was 20 × 5s = 100s — too noisy)
WINDOW_PERIOD=120

# Trend filter: BUY only when price > this SMA (480 × 5s ≈ 40 min)
TREND_FILTER_PERIOD=480

# ATR stop-loss — replaces fixed 3%. stop = entry - ATR_STOPLOSS_K × ATR(14)
ATR_PERIOD=14
ATR_STOPLOSS_K=1.5
FALLBACK_STOP_LOSS_MULTIPLIER=0.97

# Partial exits: 50% at SMA, 50% at upper Bollinger Band (true = enabled)
PARTIAL_EXITS_ENABLED=true

# Dynamic position sizing scalars
VOLATILITY_SENSITIVITY=20.0   # higher = more size reduction in volatile regimes
MIN_POSITION_SCALAR=0.4       # floor: never trade below 40% of base notional

# ── SOL Momentum Strategy ──────────────────────────────────────────────────────
# EMA crossover periods (at 5s polling: fast=20≈100s, slow=50≈250s)
SOL_EMA_FAST_PERIOD=20
SOL_EMA_SLOW_PERIOD=50

# ATR stop-loss — wider than mean-reversion; momentum needs room to breathe
SOL_ATR_PERIOD=14
SOL_ATR_STOPLOSS_K=2.0
SOL_FALLBACK_STOP_MULTIPLIER=0.95

# Sentiment gate: only suppress entry in extreme panic (SEVERE_FEAR = -0.30)
SOL_SENTIMENT_ENTRY_GATE=-0.30

# Capital allocation for SOL (fraction of PORTFOLIO_USD)
SOL_ALLOCATION=0.20

# ── Sentiment Oracle ───────────────────────────────────────────────────────────
# Poll interval in seconds (default 60 — reduced from 300 for faster XRP event detection)
SENTIMENT_POLL_INTERVAL_SEC=60

# XRP keyword filter: headlines must contain at least one term (case-insensitive)
XRP_SENTIMENT_KEYWORDS=xrp,ripple,sec,lawsuit,court,ruling,settlement,judge,ripple labs

# Optional comma-separated XRP-specific RSS feeds (leave blank to use main feeds only)
XRP_RSS_FEEDS=

# ── XRP ATR Breakout Strategy ──────────────────────────────────────────────────
# ATR period for Wilder's smoothing
XRP_ATR_PERIOD=14

# Entry: price spike must exceed this multiple of ATR in a single tick
XRP_ATR_BREAKOUT_K=2.0

# Stop-loss: exit if price drops this multiple of ATR from entry
XRP_ATR_STOPLOSS_K=1.5

# Take-profit: exit at this return (1.08 = 8%)
XRP_TAKE_PROFIT_MULT=1.08

# Sentiment gate: suppress BUY entry if XRP sentiment score is below this threshold
XRP_SENTIMENT_FEAR_GATE=-0.10

# Sentiment exit: SELL if score drops below this while position is profitable
XRP_SENTIMENT_EXIT_GATE=-0.15

# Capital allocation for XRP (fraction of PORTFOLIO_USD)
XRP_ALLOCATION=0.15
